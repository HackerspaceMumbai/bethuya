@using Bethuya.Hybrid.Shared.Auth
@using Bethuya.Hybrid.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider
@inject ILogger<NavMenu> Logger

<nav class="sidebar-nav" aria-label="Main navigation" data-test="sidebar-nav">
    <div class="brand-row">
        <a class="brand-link" href="" aria-label="Hackerspace Mumbai - Community Command Center">
            <svg class="brand-logo" width="36" height="36" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                <polygon points="18,2 33,10 33,26 18,34 3,26 3,10" fill="none" stroke="currentColor" stroke-width="1.5" />
                <path d="M11 22 L11 16 L15 12 L18 10 L21 12 L25 16 L25 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <rect x="15" y="17" width="6" height="5" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <div class="brand-text">
                <span class="brand-name">Hackerspace</span>
                <span class="brand-sub">Mumbai</span>
            </div>
        </a>
    </div>

    <input type="checkbox" id="nav-toggle" title="Toggle navigation menu" class="navbar-toggler" aria-controls="nav-links" />
    <label for="nav-toggle" class="navbar-toggler-label" aria-hidden="true"></label>

    <div id="nav-links" class="nav-links" onclick="document.getElementById('nav-toggle').checked = false">
        <div class="nav-section" data-test="nav-section-community">
            <div class="nav-section-label">Community</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="events" data-test="nav-events-link">
                    <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    Events &amp; Gatherings
                </NavLink>
            </div>
            <AuthorizeView Roles="@CommunityOperateRoles" Context="programsContext">
                <div class="nav-item">
                    <NavLink class="nav-link" href="programs" Match="NavLinkMatch.Prefix" data-test="nav-programs-link">
                        <LucideIcon Name="users-round" Size="18" Class="nav-icon" />
                        Programs &amp; Guilds
                    </NavLink>
                </div>
            </AuthorizeView>
            <AuthorizeView Roles="@DirectoryRoles" Context="directoryContext">
                <div class="nav-item">
                    <NavLink class="nav-link" href="community/passports" Match="NavLinkMatch.Prefix" data-test="nav-community-passports-link">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Directory
                    </NavLink>
                </div>
            </AuthorizeView>
        </div>

        <div class="nav-section" data-test="nav-section-insights">
            <div class="nav-section-label">Insights</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="community-graph?view=ledger" Match="NavLinkMatch.Prefix" data-test="nav-participation-ledger-link">
                    <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                    Participation Ledger
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="community-graph?view=topology" Match="NavLinkMatch.Prefix" data-test="nav-relationship-topology-link">
                    <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="m7 7 3 3m4 0 3-3M7 17l3-3m4 0 3 3"/></svg>
                    Relationship Topology
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="community-graph" Match="NavLinkMatch.Prefix" data-test="nav-community-graph-link">
                    <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/></svg>
                    Community Graph
                </NavLink>
            </div>
        </div>

        <div class="nav-section" data-test="nav-section-my-space">
            <div class="nav-section-label">My Space</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="passport" Match="NavLinkMatch.Prefix" data-test="nav-passport-link">
                    <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 4h10a2 2 0 0 1 2 2v12l-7-3-7 3V6a2 2 0 0 1 2-2z"/>
                    </svg>
                    My Passport
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="profile" Match="NavLinkMatch.Prefix" data-test="nav-profile-link">
                    <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                    </svg>
                    My Profile
                </NavLink>
            </div>
        </div>

        <AuthorizeView Roles="@OrganizerSectionRoles" Context="organizerContext">
            <div class="nav-section" data-test="nav-section-organizer">
                <div class="nav-section-label">Organizer</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" data-test="nav-command-center-link">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                        </svg>
                        Command Center
                    </NavLink>
                </div>
                <AuthorizeView Roles="@PathFinderRoles" Context="pathFinderContext">
                    <div class="nav-item">
                        <NavLink class="nav-link" href="opportunities" Match="NavLinkMatch.Prefix" data-test="nav-path-finder-link">
                            <LucideIcon Name="sparkles" Size="18" Class="nav-icon" />
                            Path Finder
                        </NavLink>
                    </div>
                </AuthorizeView>
                <AuthorizeView Roles="@ImportsRoles" Context="importsContext">
                    <div class="nav-item">
                        <NavLink class="nav-link" href="@(_currentEventId is Guid importEventId ? $"imports?eventId={importEventId}" : "imports")" Match="NavLinkMatch.Prefix" data-test="nav-imports-link">
                            <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
                            </svg>
                            Data Sources &amp; Imports
                        </NavLink>
                    </div>
                </AuthorizeView>
                @if (_currentEventId is Guid currentEventId)
                {
                    <AuthorizeView Roles="@AgentWorkflowRoles" Context="agentContext">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"agents/{currentEventId}")" Match="NavLinkMatch.Prefix" data-test="nav-agent-workflows-link">
                                <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 8V4H8" /><rect x="4" y="8" width="16" height="12" rx="2" /><path d="M8 12h8" /><path d="M8 16h5" />
                                </svg>
                                Agent Workflows
                            </NavLink>
                        </div>
                    </AuthorizeView>
                    <AuthorizeView Roles="@CurationRoles" Context="curationContext">
                        @if (ShouldShowCurationLink)
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link" href="@($"curation/{currentEventId}")" Match="NavLinkMatch.Prefix" data-test="nav-curation-link">
                                    <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 7h18" /><path d="M7 12h10" /><path d="M10 17h4" />
                                    </svg>
                                    Curation
                                </NavLink>
                            </div>
                        }
                        else if (_curationAvailability is { IsOversubscribed: false } availability)
                        {
                            <div class="nav-item">
                                <p class="text-xs text-muted-foreground p-3 italic" data-test="nav-curation-not-needed">
                                    Curation opens when registrations exceed capacity (@availability.ActiveRegistrations of @availability.Capacity).
                                </p>
                            </div>
                        }
                    </AuthorizeView>
                }
            </div>
        </AuthorizeView>

        <div class="nav-section nav-section--bottom" data-test="nav-user-context">
            <LoginDisplay />
        </div>
    </div>
</nav>

@code {
    private const string CommunityOperateRoles = $"{BethuyaRoles.Admin},{BethuyaRoles.Organizer},{BethuyaRoles.Curator}";
    private const string DirectoryRoles = $"{BethuyaRoles.Admin},{BethuyaRoles.Organizer}";
    private const string OrganizerSectionRoles = $"{BethuyaRoles.Admin},{BethuyaRoles.Organizer},{BethuyaRoles.Curator}";
    private const string PathFinderRoles = $"{BethuyaRoles.Admin},{BethuyaRoles.Organizer}";
    private const string ImportsRoles = $"{BethuyaRoles.Admin},{BethuyaRoles.Organizer}";
    private const string AgentWorkflowRoles = $"{BethuyaRoles.Admin},{BethuyaRoles.Organizer}";
    private const string CurationRoles = $"{BethuyaRoles.Admin},{BethuyaRoles.Curator}";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid? _currentEventId;
    private bool _isOnCurationRoute;
    private bool _availabilityResolved;
    private CurationAvailabilityDto? _curationAvailability;
    private CancellationTokenSource? _availabilityLoadCts;

    private bool ShouldShowCurationLink =>
        _isOnCurationRoute
        || (_availabilityResolved && (_curationAvailability is null || _curationAvailability.IsOversubscribed));

    protected override Task OnInitializedAsync()
    {
        UpdateEventContext();
        Navigation.LocationChanged += HandleLocationChanged;
        return LoadCurationAvailabilityAsync();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var previousEventId = _currentEventId;
        UpdateEventContext();
        _ = InvokeAsync(async () =>
        {
            if (previousEventId != _currentEventId || _currentEventId is not null)
            {
                await LoadCurationAvailabilityAsync();
            }

            StateHasChanged();
        });
    }

    private void UpdateEventContext()
    {
        (_currentEventId, _isOnCurationRoute) = TryGetEventContextFromUri();
    }

    private async Task LoadCurationAvailabilityAsync()
    {
        _availabilityLoadCts?.Cancel();
        _availabilityLoadCts?.Dispose();
        _availabilityLoadCts = new CancellationTokenSource();
        var loadCts = _availabilityLoadCts;
        var cancellationToken = loadCts.Token;
        var eventId = _currentEventId;
        _curationAvailability = null;
        _availabilityResolved = false;

        if (eventId is not Guid id || !await CanCurateAsync(cancellationToken))
        {
            return;
        }

        var curationApi = ServiceProvider.GetService<ICurationApi>();
        CurationAvailabilityDto? availability = null;
        if (curationApi is not null)
        {
            try
            {
                availability = await curationApi.GetAvailabilityAsync(id, cancellationToken);
            }
            catch (OperationCanceledException) when (loadCts.IsCancellationRequested)
            {
                return;
            }
            catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
            {
                Logger.LogWarning(ex, "Unable to read curation availability for event {EventId}", id);
            }
        }

        if (ReferenceEquals(_availabilityLoadCts, loadCts) && _currentEventId == eventId)
        {
            _curationAvailability = availability;
            _availabilityResolved = true;
        }
    }

    private async Task<bool> CanCurateAsync(CancellationToken cancellationToken)
    {
        if (AuthenticationStateTask is null)
        {
            return false;
        }

        AuthenticationState authenticationState;
        try
        {
            authenticationState = await AuthenticationStateTask.WaitAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return false;
        }

        var user = authenticationState.User;
        return user.IsInRole(BethuyaRoles.Admin) || user.IsInRole(BethuyaRoles.Curator);
    }

    private (Guid? EventId, bool IsCurationRoute) TryGetEventContextFromUri()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var queryStart = relative.IndexOfAny(['?', '#']);
        var path = (queryStart >= 0 ? relative[..queryStart] : relative).Trim('/');
        if (string.IsNullOrWhiteSpace(path))
        {
            return (null, false);
        }

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 &&
            (string.Equals(segments[0], "events", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(segments[0], "agents", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(segments[0], "curation", StringComparison.OrdinalIgnoreCase)) &&
            Guid.TryParse(segments[1], out var eventIdFromRoute))
        {
            return (eventIdFromRoute, string.Equals(segments[0], "curation", StringComparison.OrdinalIgnoreCase));
        }

        if (segments.Length == 1 &&
            string.Equals(segments[0], "imports", StringComparison.OrdinalIgnoreCase) &&
            queryStart >= 0 &&
            Guid.TryParse(GetQueryValue(relative[(queryStart + 1)..].Split('#')[0], "eventId"), out var eventIdFromQuery))
        {
            return (eventIdFromQuery, false);
        }

        return (null, false);
    }

    private static string? GetQueryValue(string query, string key)
    {
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=');
            if (separator > 0 && string.Equals(Uri.UnescapeDataString(pair[..separator]), key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(pair[(separator + 1)..]);
            }
        }

        return null;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        _availabilityLoadCts?.Cancel();
        _availabilityLoadCts?.Dispose();
    }
}
