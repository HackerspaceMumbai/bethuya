@inject DialogService DialogService
@inject IJSRuntime Js
@inject NavigationManager Navigation

<article class="passport-shell" aria-label="Bethuya Community Passport">
    @if (!string.IsNullOrWhiteSpace(StatusMessage) || !string.IsNullOrWhiteSpace(_localStatus))
    {
        <div aria-live="polite" data-test="community-passport-status">
            <BbAlert Variant="AlertVariant.Success">@(StatusMessage ?? _localStatus)</BbAlert>
        </div>
    }

    <PassportHero Model="Model" OnExport="OnExport" OnShare="SharePassportAsync" />

    @if (Model.Viewer.IsParticipationRedacted)
    {
        <BbAlert Variant="AlertVariant.Info">
            This member has not shared participation intelligence with organizers. Identity details remain visible, while evidence-backed sections are private.
        </BbAlert>
    }

    <div class="passport-composition">
        <main class="passport-primary-journal" data-test="passport-primary-journal">
            <VerifiedParticipationSummary Model="Model" />
            <CommunityJourney Journey="Model.Journey" />
            <CommunityPortfolio Portfolio="Model.Portfolio"
                                CanEdit="Model.Viewer.CanEdit"
                                OnEdit="OpenPortfolioDialog"
                                OnDelete="ConfirmDeleteAsync" />
            <ContributionTimeline Contributions="Model.Contributions"
                                  IsOrganizer="Model.Viewer.IsOrganizer" />
        </main>

        <aside class="passport-secondary-rail" aria-label="Passport context" data-test="passport-secondary-rail">
            <OpportunityRecommendations Opportunities="Model.Opportunities" />
            <CommunityConnections Connections="Model.Connections" />
            <ParticipationRhythm Activity="Model.Activity"
                                 VerifiedContributionCount="@Model.Contributions.Count(item => item.IsVerified)"
                                 ConnectionCount="Model.Connections.Count"
                                 ActivePathwayCount="@Model.Journey.Count(pathway => pathway.CurrentStage != "Getting started")" />
            <PassportTrustContext Model="Model" />
        </aside>
    </div>

    @if (Model.Viewer.IsOwner)
    {
        <PrivacyControls Model="Model" OnExport="OnExport" OnSavePrivacy="OnSavePrivacy" />
    }
</article>

<BbDialog @bind-Open="_portfolioDialogOpen">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>@(_editingPortfolioId is null ? "Add an Initiative" : "Edit Initiative")</BbDialogTitle>
            <BbDialogDescription>Describe a concrete community outcome and add one optional HTTPS source.</BbDialogDescription>
        </BbDialogHeader>
        <div class="dialog-form">
            <div data-test="portfolio-title-input">
                <BbFormFieldInput TValue="string" @bind-Value="_portfolioTitle" Label="Initiative title" />
            </div>
            <div class="form-group">
                <BbLabel>Contribution &amp; impact</BbLabel>
                <BbTextarea @bind-Value="_portfolioDescription" MaxLength="2000" ShowCharacterCount="true" />
            </div>
            <div data-test="portfolio-link-input">
                <BbFormFieldInput TValue="string" @bind-Value="_portfolioLink" Label="Evidence link (optional)" />
            </div>
            <label class="switch-row"><BbSwitch @bind-Checked="_portfolioFeatured" AriaLabel="Feature this initiative" /><span>Feature this initiative</span></label>
        </div>
        <BbDialogFooter>
            <BbDialogClose><BbButton Variant="ButtonVariant.Outline">Cancel</BbButton></BbDialogClose>
            <div data-test="portfolio-save-btn"><BbButton OnClick="SavePortfolioAsync">Save Initiative</BbButton></div>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter, EditorRequired] public CommunityPassportExperienceDto Model { get; set; } = default!;
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public EventCallback<UpdatePassportPrivacyPreferencesDto> OnSavePrivacy { get; set; }
    [Parameter] public EventCallback<PortfolioEditRequest> OnSavePortfolio { get; set; }
    [Parameter] public EventCallback<Guid> OnDeletePortfolio { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }

    private string? _localStatus;
    private bool _portfolioDialogOpen;
    private Guid? _editingPortfolioId;
    private string _portfolioTitle = string.Empty;
    private string _portfolioDescription = string.Empty;
    private string _portfolioLink = string.Empty;
    private bool _portfolioFeatured;
    private int _portfolioDisplayOrder;
    private IReadOnlyList<PortfolioLinkDto> _portfolioOriginalLinks = [];
    private IReadOnlyList<Guid> _portfolioEvidenceEntryIds = [];

    private async Task SharePassportAsync()
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
        _localStatus = "Passport link copied.";
    }

    private void OpenPortfolioDialog(PortfolioEntryDto? entry)
    {
        _editingPortfolioId = entry?.Id;
        _portfolioTitle = entry?.Title ?? string.Empty;
        _portfolioDescription = entry?.Description ?? string.Empty;
        _portfolioLink = entry?.Links.FirstOrDefault()?.Url ?? string.Empty;
        _portfolioFeatured = entry?.IsFeatured ?? false;
        _portfolioDisplayOrder = entry?.DisplayOrder
            ?? (Model.Portfolio.Entries.Count == 0 ? 0 : Model.Portfolio.Entries.Max(item => item.DisplayOrder) + 1);
        _portfolioOriginalLinks = entry?.Links ?? [];
        _portfolioEvidenceEntryIds = entry?.EvidenceEntryIds ?? [];
        _portfolioDialogOpen = true;
    }

    private async Task SavePortfolioAsync()
    {
        var trimmedLink = _portfolioLink.Trim();
        IReadOnlyList<PortfolioLinkDto> links;
        if (string.IsNullOrWhiteSpace(trimmedLink))
        {
            links = _portfolioOriginalLinks.Skip(1).ToArray();
        }
        else if (_portfolioOriginalLinks.Count == 0)
        {
            links = [new PortfolioLinkDto("Link", trimmedLink, null)];
        }
        else
        {
            links =
            [
                _portfolioOriginalLinks[0] with { Url = trimmedLink },
                .. _portfolioOriginalLinks.Skip(1)
            ];
        }

        await OnSavePortfolio.InvokeAsync(new PortfolioEditRequest(
            _editingPortfolioId,
            new UpsertPortfolioEntryDto(
                _portfolioTitle,
                _portfolioDescription,
                _portfolioFeatured,
                _portfolioDisplayOrder,
                links,
                _portfolioEvidenceEntryIds)));
        _portfolioDialogOpen = false;
    }

    private async Task ConfirmDeleteAsync(Guid entryId)
    {
        var result = await DialogService.ConfirmAsync(
            "Remove this initiative?",
            "The verified participation record stays intact; only the member-curated initiative is removed.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Remove" });
        if (result.Confirmed)
        {
            await OnDeletePortfolio.InvokeAsync(entryId);
        }
    }
}
