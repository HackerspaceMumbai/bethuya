@using Bethuya.Hybrid.Shared.Models.CommandCenter

<aside class="command-rail" aria-label="Organizational workload">
    @if (EventMode)
    {
        @RenderDeadlines
    }

    @if (ShowApprovals)
    {
        <section class="rail-panel" data-test="pending-approvals">
            <div class="rail-heading">
                <span>Pending approvals</span>
                <strong>@Reviews.Sum(item => item.Count)</strong>
            </div>
            @foreach (var item in Reviews)
            {
                <a href="@item.Route"><span>@item.Label</span><strong>@item.Count</strong></a>
            }
        </section>
    }

    @if (!EventMode)
    {
        @RenderDeadlines
    }

    <section class="rail-panel" data-test="quick-actions">
        <div class="rail-heading"><span>Quick actions</span></div>
        @foreach (var action in QuickActions)
        {
            <a href="@action.Route" data-test="quick-action">
                <LucideIcon Name="@action.Icon" Size="15" />
                <span>@action.Label</span>
            </a>
        }
    </section>

    <nav class="rail-panel" aria-label="Quick navigation" data-test="quick-navigation">
        <div class="rail-heading"><span>Go deeper</span></div>
        @foreach (var workspace in Workspaces)
        {
            <a href="@workspace.Route">
                <LucideIcon Name="@workspace.Icon" Size="15" />
                <span>@workspace.Label</span>
                <LucideIcon Name="arrow-up-right" Size="14" />
            </a>
        }
    </nav>
</aside>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ReviewItem> Reviews { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<DeadlineItem> Deadlines { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<QuickAction> QuickActions { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<WorkspaceLink> Workspaces { get; set; } = [];
    [Parameter] public bool ShowApprovals { get; set; } = true;

    /// <summary>In Event mode deadlines lead the rail because they gate event execution.</summary>
    [Parameter] public bool EventMode { get; set; }

    private RenderFragment RenderDeadlines => @<section class="@($"rail-panel {(EventMode ? "rail-panel--priority" : "")}")" data-test="upcoming-deadlines">
        <div class="rail-heading"><span>Upcoming deadlines</span></div>
        @foreach (var deadline in Deadlines)
        {
            <a href="@deadline.Route" class="deadline-link">
                <span>@deadline.Label</span>
                <small>@deadline.DueLabel</small>
            </a>
        }
    </section>;
}
