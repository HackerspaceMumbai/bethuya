@page "/passport"
@rendermode InteractiveServer
@attribute [Authorize]
@using Bethuya.Hybrid.Shared.Components.Passport
@using Bethuya.Hybrid.Shared.Services
@inject ICommunityPassportApi CommunityPassportApi
@inject IJSRuntime Js

<PageTitle>My Community Passport — Bethuya</PageTitle>

<main data-test="community-passport-page">
    @if (_isLoading)
    {
        <div class="p-8" data-test="community-passport-loading">
            <BbAlert Variant="AlertVariant.Info">Opening your Community Passport…</BbAlert>
        </div>
    }
    else if (_passport is null && _errorMessage is not null)
    {
        <div class="p-8" data-test="community-passport-error">
            <BbAlert Variant="AlertVariant.Danger">@_errorMessage</BbAlert>
        </div>
    }
    else if (_passport is not null)
    {
        @if (_errorMessage is not null)
        {
            <div class="p-8" data-test="community-passport-error">
                <BbAlert Variant="AlertVariant.Danger">@_errorMessage</BbAlert>
            </div>
        }
        <PassportExperienceView Model="_passport"
                                StatusMessage="@StatusMessage"
                                OnSavePrivacy="SavePrivacyAsync"
                                OnSavePortfolio="SavePortfolioAsync"
                                OnDeletePortfolio="DeletePortfolioAsync"
                                OnExport="ExportAsync" />
    }
</main>

@code {
    private CommunityPassportExperienceDto? _passport;
    private string? _errorMessage;
    private string? StatusMessage { get; set; }
    private bool _isLoading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _passport = await CommunityPassportApi.GetExperienceAsync();
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            _errorMessage = "We couldn’t open your Community Passport. Refresh and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SavePrivacyAsync(UpdatePassportPrivacyPreferencesDto request)
    {
        try
        {
            _ = await CommunityPassportApi.SavePrivacyPreferencesAsync(request);
            StatusMessage = "Privacy and discovery preferences saved.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            _errorMessage = "We couldn’t save your privacy preferences.";
        }
    }

    private async Task<bool> SavePortfolioAsync(PortfolioEditRequest request)
    {
        var saved = false;
        try
        {
            _ = request.Id is Guid id
                ? await CommunityPassportApi.UpdatePortfolioEntryAsync(id, request.Entry)
                : await CommunityPassportApi.CreatePortfolioEntryAsync(request.Entry);
            StatusMessage = "Portfolio entry saved.";
            await LoadAsync();
            saved = true;
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            _errorMessage = "We couldn’t save that portfolio entry.";
        }
        await InvokeAsync(StateHasChanged);
        return saved;
    }

    private async Task DeletePortfolioAsync(Guid entryId)
    {
        try
        {
            await CommunityPassportApi.DeletePortfolioEntryAsync(entryId);
            StatusMessage = "Portfolio entry removed.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            _errorMessage = "We couldn’t remove that portfolio entry.";
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            using var response = await CommunityPassportApi.ExportPassportAsync();
            response.EnsureSuccessStatusCode();
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await Js.InvokeVoidAsync(
                "BethuyaPassport.downloadBase64",
                "passport-export.zip",
                "application/zip",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException or JSException)
        {
            _errorMessage = "We couldn’t prepare your passport export.";
        }
    }
}
