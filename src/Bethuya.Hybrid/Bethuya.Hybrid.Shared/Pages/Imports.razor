@page "/imports"
@rendermode InteractiveServer
@attribute [Authorize(Policy = BethuyaAuthorizationPolicies.RequireOrganizer)]
@using BlazorBlueprint.Components
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@inject IImportApi ImportApi
@inject IEventApi EventApi
@inject ILogger<Imports> Logger

<PageTitle>Import registrations and attendance — Bethuya</PageTitle>

<div class="container mx-auto p-4" data-test="import-page">
    <h1 class="text-2xl font-bold mb-2">Import registrations or attendance</h1>
    <p class="text-muted-foreground mb-6">Upload a Luma, MLH, or spreadsheet export. Bethuya validates it first; nothing is changed until you commit the preview.</p>

    @* Focusable (tabindex=-1) so failures and commit results can be scrolled into view and announced. *@
    <div @ref="_statusRegion" tabindex="-1" role="status" aria-live="polite" data-test="import-status">
        @if (_error is not null)
        {
            <div data-test="import-error"><BbAlert Variant="AlertVariant.Danger">@_error</BbAlert></div>
        }
        @if (_message is not null)
        {
            <div data-test="import-success"><BbAlert Variant="AlertVariant.Success">@_message</BbAlert></div>
        }
    </div>

    <BbCard Class="p-4 mb-6">
        <BbFormSection Title="1. Choose an export">
            @if (_staleEventNotice is not null)
            {
                <div data-test="import-stale-event">
                    <BbAlert Variant="AlertVariant.Warning">@_staleEventNotice</BbAlert>
                </div>
            }
            <div data-test="import-event-select">
                <BbFormFieldSelect TValue="string" @bind-Value="_eventIdText" Label="Event" Placeholder="Choose an event" DisplayTextSelector="GetEventTitle">
                    @foreach (var item in _events)
                    {
                        <BbSelectItem Value="@item.Id.ToString()" Text="@item.Title" />
                    }
                </BbFormFieldSelect>
            </div>
            <div data-test="import-kind-select">
                <BbFormFieldSelect TValue="string" @bind-Value="_importKind" @bind-Value:after="LoadTemplatesAsync" Label="Data type" DisplayTextSelector="GetImportKindTitle">
                    <BbSelectItem Value="@("Registration")" Text="Registrations and approval updates" />
                    <BbSelectItem Value="@("Attendance")" Text="Attendance" />
                </BbFormFieldSelect>
            </div>
            @if (_importKind == "Registration")
            {
                <p class="text-sm text-muted-foreground" data-test="registration-import-guidance">
                    Use this for registration requests and approval decisions. Re-import an updated export, or upload a separate approval file; matching email and event update the same registration. New records without an approval field remain pending.
                </p>
            }
            else
            {
                <p class="text-sm text-muted-foreground" data-test="attendance-import-guidance">
                    Use this only for check-ins. Rows need an actual check-in time; blank check-in times are skipped.
                </p>
            }
            <div data-test="import-template-select">
                <BbFormFieldSelect TValue="string" @bind-Value="_templateIdText" Label="Source template" Placeholder="Choose a template" DisplayTextSelector="GetTemplateTitle">
                    @foreach (var template in Templates)
                    {
                        <BbSelectItem Value="@template.Id.ToString()" Text="@template.Name" />
                    }
                </BbFormFieldSelect>
            </div>
            <div class="form-group" data-test="import-file-field">
                <BbLabel>CSV or XLSX file</BbLabel>
                <BbFileUpload FilesChanged="HandleFileSelected"
                              Accept=".csv,.xlsx"
                              MaxFileSize="@(10 * 1024 * 1024)"
                              OnValidationError="@(error => _fileError = error.Message)" />
                @if (_selectedFile is not null)
                {
                    <p class="text-sm mt-2">Selected: @_selectedFile.Name</p>
                }
                @if (_fileError is not null)
                {
                    <p class="text-sm text-destructive mt-1">@_fileError</p>
                }
            </div>
            <div data-test="start-dry-run">
                <BbButton OnClick="StartDryRunAsync" Disabled="@(_busy || _selectedFile is null)">@(_validating ? "Validating…" : "Run validation")</BbButton>
            </div>
            @if (_missingInputs is not null)
            {
                <div data-test="dry-run-missing-inputs" role="alert">
                    <BbAlert Variant="AlertVariant.Warning">@_missingInputs</BbAlert>
                </div>
            }
            @if (_validating)
            {
                <div data-test="dry-run-in-progress">
                    <BbAlert Variant="AlertVariant.Info">Validating @_selectedFile?.Name… this can take a few seconds for large exports.</BbAlert>
                </div>
            }
        </BbFormSection>
    </BbCard>

    @if (_batch is not null)
    {
        @* Focusable (tabindex=-1) so a finished validation scrolls the preview into view. *@
        <div data-test="import-preview" @ref="_previewRegion" tabindex="-1">
            <BbCard Class="p-4 mb-6">
                <BbFormSection Title="2. Review preview">
                @if (_preview is not null)
                {
                    <div data-test="dry-run-result">
                        @if (_preview.ErrorRows == 0 && _batch.Status == ImportBatchStatusDto.Committed)
                        {
                            <BbAlert Variant="AlertVariant.Success">This batch has been committed: @_batch.RowsToCreate created, @_batch.RowsToUpdate existing. @(_preview.TotalRows - _preview.ErrorRows - _preview.RowsToCreate - _preview.RowsToUpdate) rows without a check-in were skipped.</BbAlert>
                        }
                        else if (_preview.ErrorRows == 0 && _batch.CanCommit)
                        {
                            <BbAlert Variant="AlertVariant.Success">
                                @if (!string.IsNullOrWhiteSpace(_batch?.FileName))
                                {
                                    <span data-test="validated-file-name">Validated <strong>@_batch.FileName</strong>. </span>
                                }
                                Validation passed: @_preview.RowsToCreate new, @_preview.RowsToUpdate existing, @(_preview.TotalRows - _preview.ErrorRows - _preview.RowsToCreate - _preview.RowsToUpdate) without check-in (skipped). Nothing has been imported yet; review the rows below and commit when ready.
                            </BbAlert>
                        }
                        else if (_preview.ErrorRows == 0)
                        {
                            <BbAlert Variant="AlertVariant.Warning">All rows are valid, but this batch can no longer be committed (status: @_batch.Status). Run validation again.</BbAlert>
                        }
                        else
                        {
                            <BbAlert Variant="AlertVariant.Warning">
                                Validation found @_preview.ErrorRows of @_preview.TotalRows rows with errors. Sort by Result to see them, fix the source file, and upload it again before committing.
                            </BbAlert>
                        }
                    </div>
                }
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-4">
                    <span>Total: <strong>@_batch.TotalRows</strong></span>
                    <span>Valid: <strong>@_batch.ValidRows</strong></span>
                    <span>Errors: <strong>@_batch.ErrorRows</strong></span>
                    <span>Creates: <strong>@_batch.RowsToCreate</strong></span>
                    <span>Updates: <strong>@_batch.RowsToUpdate</strong></span>
                    <span>Skipped: <strong>@(_batch.TotalRows - _batch.ErrorRows - _batch.RowsToCreate - _batch.RowsToUpdate)</strong></span>
                </div>
                @if (_batch.CanCommit && _preview is { ErrorRows: 0 })
                {
                    <div data-test="commit-import">
                        <BbButton Variant="ButtonVariant.Default" OnClick="CommitAsync" Disabled="@_busy">@(_committing ? "Committing…" : $"Commit import ({_preview.RowsToCreate + _preview.RowsToUpdate} rows)")</BbButton>
                    </div>
                }
                @if (_preview is not null)
                {
                    <div data-test="import-preview-table">
                        <BbDataTable TData="ImportRowPreviewDto" Data="@_preview.Rows"
                                     InitialPageSize="25" PageSizes="@PreviewPageSizes"
                                     AriaLabel="Dry run preview rows">
                            <Columns>
                                <BbDataTableColumn TData="ImportRowPreviewDto" TValue="int" Header="Row" Property="@(r => r.RowIndex + 1)" Sortable="true" />
                                <BbDataTableColumn TData="ImportRowPreviewDto" TValue="string" Header="Email" Property="@(r => r.Email ?? string.Empty)" Sortable="true" Filterable="true" />
                                <BbDataTableColumn TData="ImportRowPreviewDto" TValue="string" Header="Result" Property="@(r => r.Disposition)" Sortable="true" Filterable="true">
                                    <CellTemplate Context="row">
                                        <BbBadge Variant="@(row.ValidationErrors.Count > 0 ? BadgeVariant.Destructive : BadgeVariant.Secondary)">@row.Disposition</BbBadge>
                                    </CellTemplate>
                                </BbDataTableColumn>
                                <BbDataTableColumn TData="ImportRowPreviewDto" TValue="string" Header="Details" Property="@(r => _errorSummaries.GetValueOrDefault(r.RowIndex, string.Empty))" Filterable="true" />
                            </Columns>
                        </BbDataTable>
                    </div>
                }
                else
                {
                    <div data-test="import-preview-unavailable">
                        <BbAlert Variant="AlertVariant.Warning">The row-level preview could not be loaded for this batch.</BbAlert>
                        <BbButton OnClick="RetryPreviewAsync" Disabled="@_busy">Retry preview</BbButton>
                    </div>
                }
                </BbFormSection>
            </BbCard>
        </div>
    }

    @if (_busy && !_validating && !_committing)
    {
        <BbAlert Variant="AlertVariant.Info">Working…</BbAlert>
    }
</div>

@code {
    private readonly List<EventDto> _events = [];
    private List<ImportTemplateDto> Templates { get; set; } = [];
    private string? _eventIdText;
    private string _importKind = "Registration";
    private string? _templateIdText;
    private IBrowserFile? _selectedFile;
    private ImportBatchDto? _batch;
    private ImportPreviewReportDto? _preview;
    private string? _error;
    private string? _message;
    private string? _fileError;
    private string? _missingInputs;
    private string? _staleEventNotice;
    private bool _busy;
    private bool _validating;
    private bool _committing;
    private ElementReference _statusRegion;
    private ElementReference _previewRegion;
    private FocusTarget _pendingFocus;
    private static readonly int[] PreviewPageSizes = [25, 50, 100];
    private readonly Dictionary<int, string> _errorSummaries = [];

    private enum FocusTarget { None, Status, Preview }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var target = _pendingFocus;
        _pendingFocus = FocusTarget.None;
        try
        {
            // Focusing a tabindex=-1 region scrolls it into view natively — no custom JS needed.
            if (target == FocusTarget.Preview && _batch is not null)
            {
                await _previewRegion.FocusAsync();
            }
            else if (target == FocusTarget.Status && (_error is not null || _message is not null))
            {
                await _statusRegion.FocusAsync();
            }
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not move focus to the import {FocusTarget} region", target);
        }
    }

    /// <summary>Optional event to preselect when the wizard is opened from an event context.</summary>
    [SupplyParameterFromQuery(Name = "eventId")]
    public Guid? EventId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _events.AddRange(await EventApi.GetAllAsync());
            if (EventId is Guid eventId && _events.Any(e => e.Id == eventId))
            {
                _eventIdText = eventId.ToString();
            }
            else
            {
                if (EventId is not null)
                {
                    // Links can outlive their event (e.g. after a reseed); say so instead of silently showing no selection.
                    _staleEventNotice = "The event in this link no longer exists. Choose an event below.";
                }

                if (EventId is null && _events.Count == 1)
                {
                    _eventIdText = _events[0].Id.ToString();
                }
            }

            await LoadTemplatesAsync();
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Failed to load events or import templates");
            _error = "Unable to load events or import templates. Please try again.";
        }
        catch (Exception ex) when (!IsFatalException(ex))
        {
            Logger.LogError(ex, "Unexpected error loading events or import templates");
            _error = "Something went wrong while loading the page. Please refresh and try again.";
        }
    }

    // Compositional BbSelectItem children only register their text once the popover opens,
    // so a preselected value (e.g. from ?eventId=) needs an explicit lookup to show its title.
    private string GetEventTitle(string value) =>
        _events.FirstOrDefault(e => e.Id.ToString() == value)?.Title ?? value;

    private static string? GetImportKindTitle(string? value) => value switch
    {
        "Registration" => "Registrations and approval updates",
        "Attendance" => "Attendance",
        _ => value
    };

    // BB select items register their text only once the popover opens, so a preselected template would show its id.
    private string? GetTemplateTitle(string? value) =>
        Templates.FirstOrDefault(t => string.Equals(t.Id.ToString(), value, StringComparison.OrdinalIgnoreCase))?.Name ?? value;

    private async Task LoadTemplatesAsync()
    {
        try
        {
            Templates = await ImportApi.ListTemplatesAsync(_importKind);
            _templateIdText = Templates.FirstOrDefault()?.Id.ToString();
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Failed to load import templates for {ImportKind}", _importKind);
            Templates = [];
            _templateIdText = null;
            _error = "Unable to load import templates. Please try again.";
        }
    }

    private async Task HandleKindChanged(ChangeEventArgs args)
    {
        _importKind = args.Value?.ToString() ?? "Registration";
        await LoadTemplatesAsync();
    }

    private void HandleFileSelected(IReadOnlyList<FileUploadItem> files)
    {
        _fileError = null;
        // BbFileUpload's MaxFileCount counts the file already selected, so a limit of 1 rejects every
        // replacement. The page leaves the default limit, lets single-file mode replace the file, and
        // rejects multi-file drops here.
        if (files.Count > 1)
        {
            _fileError = "Choose a single CSV or XLSX file.";
        }

        var newFile = files.Count == 1 ? files[0].File : null;
        if (!ReferenceEquals(newFile, _selectedFile) && !_busy)
        {
            // A preview belongs to the file it validated; keeping it after a file change misleads organizers.
            _batch = null;
            _preview = null;
            _errorSummaries.Clear();
            _message = null;
            _error = null;
        }

        _selectedFile = newFile;
    }

    private async Task StartDryRunAsync()
    {
        _error = null;
        _message = null;

        _missingInputs = null;
        if (!Guid.TryParse(_eventIdText, out var eventId) || !Guid.TryParse(_templateIdText, out var templateId) || _selectedFile is null)
        {
            List<string> missing = [];
            if (!Guid.TryParse(_eventIdText, out _)) missing.Add("an event");
            if (!Guid.TryParse(_templateIdText, out _)) missing.Add("a source template");
            if (_selectedFile is null) missing.Add("a file");
            // Shown beside the button: the status region sits at the top of the page and is easily off-screen.
            _missingInputs = $"Choose {string.Join(" and ", missing)} before running validation.";
            return;
        }

        // Clear any batch/preview from a previous attempt only once we know a genuinely new
        // attempt is underway (inputs are valid). Clearing this unconditionally at the top of
        // the method — before the guard above — meant an accidental "Run validation" click with
        // incomplete inputs (e.g. no file re-selected) would wipe out a perfectly valid, already
        // committable batch with no way back except re-uploading (see PR #60 review discussion,
        // "Earlier batch becomes inaccessible"). Clearing here still prevents a failed
        // *new* upload/validation from leaving a stale, still-committable PRIOR batch on screen
        // (see "Failed upload leaves old commit"), because the old batch is for a prior attempt
        // that is about to be superseded.
        _batch = null;
        _preview = null;
        _errorSummaries.Clear();

        _busy = true;
        _validating = true;
        ImportBatchDto? newBatch = null;
        try
        {
            await using var stream = _selectedFile.OpenReadStream(10 * 1024 * 1024);
            newBatch = await ImportApi.UploadAndRunDryRunAsync(eventId.ToString(), templateId.ToString(), _importKind, new Refit.StreamPart(stream, _selectedFile.Name, _selectedFile.ContentType));

            // Publish the batch as soon as the upload succeeds so the organizer keeps a
            // reference to it even if the preview fetch below fails — otherwise they'd have
            // no way to retry the preview without re-uploading the file and creating a
            // duplicate batch/artifact (see PR #60 review discussion). "Commit import" stays
            // hidden until _preview is also populated AND reports zero errors (see the markup
            // above), so a batch is never committable without a fresh, error-free preview.
            _batch = newBatch;

            var newPreview = await ImportApi.GetPreviewAsync(newBatch.Id);
            _preview = newPreview;
            foreach (var row in _preview.Rows)
            {
                _errorSummaries[row.RowIndex] = string.Join("; ", row.ValidationErrors);
            }
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Dry-run validation failed for event {EventId}, template {TemplateId}", eventId, templateId);
            _error = newBatch is null
                ? "The file could not be validated. Check the format and try again."
                : "The batch was uploaded, but its preview could not be loaded. Use \"Retry preview\" below, or upload the file again.";
        }
        catch (Exception ex) when (!IsFatalException(ex))
        {
            Logger.LogError(ex, "Unexpected error running dry-run validation for event {EventId}, template {TemplateId}", eventId, templateId);
            _error = newBatch is null
                ? "Something went wrong while validating the file. Please try again."
                : "The batch was uploaded, but something went wrong loading its preview. Use \"Retry preview\" below, or upload the file again.";
        }
        finally
        {
            _busy = false;
            _validating = false;
            _pendingFocus = _batch is not null ? FocusTarget.Preview : FocusTarget.Status;
            StateHasChanged();
        }
    }

    private async Task RetryPreviewAsync()
    {
        if (_batch is null) return;
        _busy = true;
        _error = null;
        try
        {
            // Re-fetch the batch alongside the preview: the batch carries TotalRows/ErrorRows
            // and CanCommit, which the server may have changed (e.g. a re-run triggered
            // elsewhere, or the template was edited) since this batch was first loaded. There's
            // an inherent race between these two independent requests — a concurrent dry-run
            // rerun could land between them — so the Commit button's render condition also
            // checks _preview.ErrorRows == 0 directly (see the markup above) rather than relying
            // solely on the batch's (possibly-stale) CanCommit flag. That keeps "Commit import"
            // hidden whenever the freshest fetched preview shows errors, regardless of which of
            // these two calls happened to land first (see PR #60 review discussion, "Retry
            // leaves commit eligibility stale" / "Retry can show stale eligibility").
            var refreshedBatch = await ImportApi.GetBatchAsync(_batch.Id);
            var preview = await ImportApi.GetPreviewAsync(_batch.Id);
            _batch = refreshedBatch;
            _preview = preview;
            _errorSummaries.Clear();
            foreach (var row in _preview.Rows)
            {
                _errorSummaries[row.RowIndex] = string.Join("; ", row.ValidationErrors);
            }
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Retry preview failed for import batch {BatchId}", _batch.Id);
            _error = "The preview could not be loaded. Please try again.";
        }
        catch (Exception ex) when (!IsFatalException(ex))
        {
            Logger.LogError(ex, "Unexpected error retrying preview for import batch {BatchId}", _batch.Id);
            _error = "Something went wrong while loading the preview. Please try again.";
        }
        finally
        {
            _busy = false;
            _pendingFocus = FocusTarget.Preview;
            StateHasChanged();
        }
    }

    private async Task CommitAsync()
    {
        if (_batch is null) return;
        _busy = true;
        _committing = true;
        _error = null;
        _message = null;
        try
        {
            _batch = await ImportApi.CommitAsync(_batch.Id);
            if (_batch.Status == ImportBatchStatusDto.Committed)
            {
                _message = "Import committed successfully. Member history and event reporting are now up to date.";
                return;
            }

            _error = !string.IsNullOrWhiteSpace(_batch.FailureReason)
                ? _batch.FailureReason
                : "The import was not committed. Please review the validation results and try again.";
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Commit failed for import batch {BatchId}", _batch?.Id);
            _error = "The import could not be committed. Refresh the preview and try again.";
        }
        catch (Exception ex) when (!IsFatalException(ex))
        {
            Logger.LogError(ex, "Unexpected error committing import batch {BatchId}", _batch?.Id);
            _error = "Something went wrong while committing the import. Please try again.";
        }
        finally
        {
            _busy = false;
            _committing = false;
            _pendingFocus = FocusTarget.Status;
            StateHasChanged();
        }
    }

    private static bool IsFatalException(Exception ex) =>
        ex is NullReferenceException or InvalidOperationException or ObjectDisposedException;
}
