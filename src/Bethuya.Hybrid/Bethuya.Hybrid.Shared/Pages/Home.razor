@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Bethuya.Hybrid.Shared.Components.CommandCenter
@using Bethuya.Hybrid.Shared.Components.Participation
@using Bethuya.Hybrid.Shared.Models.CommandCenter
@using Bethuya.Hybrid.Shared.Models.Participation
@inject ICommunityCommandCenterService CommandCenterService
@inject ICommunityParticipationService ParticipationService
@inject ICommandCenterAudienceResolver AudienceResolver

<PageTitle>@(audience?.Surface == CommandCenterSurface.Participation ? "My community journey — Bethuya" : "Community Command Center — Bethuya")</PageTitle>

<a class="skip-link" href="#home-main">Skip to main content</a>

@if (requiresAuthentication)
{
    <main id="home-main" class="command-center command-center--loading">
        <div data-test="command-center-auth-required">
            <BbAlert>
                <BbAlertTitle>Sign in to open Bethuya</BbAlertTitle>
                <BbAlertDescription>Your community experience is resolved from your authenticated identity.</BbAlertDescription>
            </BbAlert>
        </div>
    </main>
}
else if (isLoading)
{
    <main id="home-main" class="command-center command-center--loading">
        <div class="command-loading" data-test="loading-state" role="status">Reading community signals…</div>
    </main>
}
else if (errorMessage is not null)
{
    <main id="home-main" class="command-center command-center--loading">
        <div data-test="error-state">
            <BbAlert Variant="AlertVariant.Danger">
                <BbAlertTitle>Home unavailable</BbAlertTitle>
                <BbAlertDescription>@errorMessage</BbAlertDescription>
            </BbAlert>
        </div>
    </main>
}
else if (audience?.Surface == CommandCenterSurface.Participation && participation is not null)
{
    <main id="home-main" class="participation-shell" aria-label="Community participation home">
        <ParticipationSurface Model="@participation"
                              AudienceLabel="@audience.ExperienceLabel"
                              AudienceRole="@audience.Role.ToString()" />
    </main>
}
else if (model is not null && audience is not null)
{
    <main id="home-main"
          class="@($"command-center command-center--{GetModeSlug(model.EffectiveMode)}")"
          aria-label="Community operations command center"
          data-test="community-command-center">
        <header class="command-header">
            <div class="command-header__copy">
                <p class="command-kicker">Community operations · This week</p>
                <h1>Welcome back, @audience.DisplayName.</h1>
                <p class="command-subtitle">Events are moments. Communities are journeys.</p>
                <div class="command-audience" data-test="command-center-audience" data-audience="@audience.Role">
                    <span class="command-audience__label">@audience.ExperienceLabel</span>
                    <p class="command-summary">@audience.ExperienceSummary</p>
                </div>
            </div>

            <div class="command-controls" aria-label="Command center controls">
                <a class="notification-link" href="#human-review" data-test="notification-center" aria-label="Open human review queue">
                    <LucideIcon Name="bell" Size="17" />
                    <span>@model.Reviews.Sum(review => review.Count)</span>
                </a>
            </div>
        </header>

        <section class="mode-bar" aria-label="Active command center mode" data-test="mode-explanation">
            <div class="mode-status">
                <span class="mode-pulse" aria-hidden="true"></span>
                <div>
                    <strong>Currently in @model.EffectiveMode Mode</strong>
                    <p class="mode-question" data-test="mode-question">@model.ModeQuestion</p>
                    <p>@model.ModeReason</p>
                </div>
            </div>
            <div class="mode-actions" role="group" aria-label="Select command center mode">
                <div data-test="mode-strategic">
                    <button type="button"
                            class="@($"control-button {(model.EffectiveMode == CommandCenterMode.Strategic ? "control-button--active" : "")}")"
                            aria-pressed="@(model.EffectiveMode == CommandCenterMode.Strategic ? "true" : "false")"
                            @onclick="@(() => SelectModeAsync(CommandCenterMode.Strategic))">
                        Strategic
                    </button>
                </div>
                <div data-test="mode-event">
                    <button type="button"
                            class="@($"control-button {(model.EffectiveMode == CommandCenterMode.Event ? "control-button--active" : "")}")"
                            aria-pressed="@(model.EffectiveMode == CommandCenterMode.Event ? "true" : "false")"
                            @onclick="@(() => SelectModeAsync(CommandCenterMode.Event))">
                        Event · Hacktoberfest
                    </button>
                </div>
                <details class="mode-reasoning">
                    <summary>View reasoning</summary>
                    <p>Event mode is recommended when an approaching event has unresolved capacity, waitlist, volunteer, or speaker-readiness signals.</p>
                </details>
            </div>
        </section>

        <SnapshotStrip Metrics="@model.Snapshot"
                       EventMode="@(model.EffectiveMode == CommandCenterMode.Event)" />

        <div class="@($"command-layout command-layout--{GetModeSlug(model.EffectiveMode)}")"
             data-test="@($"mode-layout-{GetModeSlug(model.EffectiveMode)}")">
            <div class="command-main">
                @if (model.EffectiveMode == CommandCenterMode.Event)
                {
                    <div class="mode-priority mode-priority--event" data-test="event-primary-work">
                        <AttentionQueue Items="@model.AttentionItems" Primary="true" />
                    </div>
                    <ReviewQueue Items="@model.Reviews"
                                 EventMode="true"
                                 DataTest="pending-event-approvals" />
                    <UpcomingTouchpointsPanel Touchpoints="@model.Touchpoints" Expanded="true" />
                    <WeeklyInsightPanel Insight="@model.Insight" />
                    <PeopleToWatchPanel People="@model.PeopleToWatch" />
                }
                else
                {
                    <div class="mode-priority mode-priority--strategic" data-test="strategic-primary-work">
                        <WeeklyInsightPanel Insight="@model.Insight" />
                        <PeopleToWatchPanel People="@model.PeopleToWatch" />
                    </div>
                    <AttentionQueue Items="@model.AttentionItems" />
                    <ReviewQueue Items="@model.Reviews" />
                    <UpcomingTouchpointsPanel Touchpoints="@model.Touchpoints" Expanded="false" />
                }
            </div>
            <CommandCenterRail Reviews="@model.Reviews"
                               Deadlines="@model.Deadlines"
                               QuickActions="@model.QuickActions"
                               Workspaces="@model.Workspaces"
                               ShowApprovals="@(model.EffectiveMode != CommandCenterMode.Event)"
                               EventMode="@(model.EffectiveMode == CommandCenterMode.Event)" />
        </div>
    </main>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Task<AuthenticationState>? processedAuthenticationStateTask;
    private bool hasProcessedAuthenticationState;
    private CancellationTokenSource? loadCancellation;
    private int loadGeneration;
    private CommandCenterAudience? audience;
    private CommandCenterMode? modeOverride;
    private CommunityCommandCenter? model;
    private CommunityParticipationHome? participation;
    private bool isLoading = true;
    private bool requiresAuthentication;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (hasProcessedAuthenticationState &&
            ReferenceEquals(AuthenticationStateTask, processedAuthenticationStateTask))
        {
            return;
        }

        var authenticationStateTask = AuthenticationStateTask;
        processedAuthenticationStateTask = authenticationStateTask;
        hasProcessedAuthenticationState = true;
        CancelCurrentLoad();
        audience = null;
        model = null;
        participation = null;
        modeOverride = null;
        errorMessage = null;
        requiresAuthentication = false;
        isLoading = true;

        var principal = authenticationStateTask is null
            ? new System.Security.Claims.ClaimsPrincipal()
            : (await authenticationStateTask).User;
        if (!ReferenceEquals(authenticationStateTask, AuthenticationStateTask))
        {
            return;
        }

        if (principal.Identity?.IsAuthenticated != true)
        {
            requiresAuthentication = true;
            isLoading = false;
            return;
        }

        requiresAuthentication = false;
        audience = AudienceResolver.Resolve(principal);
        modeOverride = null;
        await LoadAsync();
    }

    private async Task SelectModeAsync(CommandCenterMode mode)
    {
        modeOverride = mode;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        CancelCurrentLoad();
        var generation = loadGeneration;
        var cancellation = new CancellationTokenSource();
        loadCancellation = cancellation;
        var cancellationToken = cancellation.Token;
        var currentAudience = audience;
        var currentModeOverride = modeOverride;

        isLoading = true;
        errorMessage = null;

        var role = currentAudience?.Role ?? CommunityRole.CommunityMember;

        try
        {
            if (currentAudience?.Surface == CommandCenterSurface.Participation)
            {
                var loadedParticipation = await ParticipationService.GetAsync(
                    role,
                    currentAudience.DisplayName,
                    cancellationToken);
                if (generation != loadGeneration)
                {
                    return;
                }

                model = null;
                participation = loadedParticipation;
            }
            else
            {
                var loadedModel = await CommandCenterService.GetAsync(
                    role,
                    currentModeOverride,
                    cancellationToken);
                if (generation != loadGeneration)
                {
                    return;
                }

                participation = null;
                model = loadedModel;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (generation == loadGeneration)
            {
                errorMessage = "Community signals could not be loaded. Refresh the page to try again.";
            }
        }
        finally
        {
            if (generation == loadGeneration)
            {
                loadCancellation = null;
                isLoading = false;
                cancellation.Dispose();
            }
        }
    }

    private void CancelCurrentLoad()
    {
        loadGeneration++;
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        loadCancellation = null;
    }

    /// <inheritdoc />
    public void Dispose() => CancelCurrentLoad();

    private static string GetModeSlug(CommandCenterMode? mode) => mode switch
    {
        CommandCenterMode.Strategic => "strategic",
        CommandCenterMode.Event => "event",
        _ => "loading"
    };
}
