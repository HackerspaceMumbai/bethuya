@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Bethuya.Hybrid.Shared.Components.CommandCenter
@using Bethuya.Hybrid.Shared.Components.Participation
@using Bethuya.Hybrid.Shared.Models.CommandCenter
@using Bethuya.Hybrid.Shared.Models.Participation
@using Microsoft.Extensions.Logging
@inject ICommunityCommandCenterService CommandCenterService
@inject ICommunityParticipationService ParticipationService
@inject ICommandCenterAudienceResolver AudienceResolver
@inject ILogger<Home> Logger

<PageTitle>@(_audience?.Surface == CommandCenterSurface.Participation ? "My community journey — Bethuya" : "Community Command Center — Bethuya")</PageTitle>

<a class="skip-link" href="#home-main">Skip to main content</a>

@if (_requiresAuthentication)
{
    <main id="home-main" class="command-center command-center--loading">
        <div data-test="command-center-auth-required">
            <BbAlert>
                <BbAlertTitle>Sign in to open Bethuya</BbAlertTitle>
                <BbAlertDescription>Your community experience is resolved from your authenticated identity.</BbAlertDescription>
            </BbAlert>
        </div>
    </main>
}
else if (_isLoading)
{
    <main id="home-main" class="command-center command-center--loading">
        <div class="command-loading" data-test="loading-state" role="status">Reading community signals…</div>
    </main>
}
else if (_errorMessage is not null)
{
    <main id="home-main" class="command-center command-center--loading">
        <div data-test="error-state">
            <BbAlert Variant="AlertVariant.Danger">
                <BbAlertTitle>Home unavailable</BbAlertTitle>
                <BbAlertDescription>@_errorMessage</BbAlertDescription>
            </BbAlert>
        </div>
    </main>
}
else if (_audience?.Surface == CommandCenterSurface.Participation && _participation is not null)
{
    <main id="home-main" class="participation-shell" aria-label="Community participation home">
        <ParticipationSurface Model="@_participation"
                              AudienceLabel="@_audience.ExperienceLabel"
                              AudienceRole="@_audience.Role.ToString()" />
    </main>
}
else if (_model is not null && _audience is not null)
{
    <main id="home-main"
          class="command-center command-center--v9"
          aria-label="Community operations command center"
          data-test="community-command-center">
        <StrategicInsightPanel Insight="@_model.Insight" />

        <ImmediateDecisionsQueue Items="@_decisions"
                                 OnPrimary="ResolveDecisionAsync"
                                 OnReview="OpenReviewForDecision"
                                 OnLaunchReviewSession="OpenReviewSession" />

        <header class="command-context" data-test="command-context">
            <div class="command-context__copy">
                <p class="command-kicker">Welcome back, @_audience.DisplayName</p>
                <div class="command-audience" data-test="command-center-audience" data-audience="@_audience.Role">
                    <span class="command-audience__label">@_audience.ExperienceLabel</span>
                    <p class="command-summary">@_audience.ExperienceSummary</p>
                </div>
            </div>
            <div class="command-controls" aria-label="Command center controls">
                <a class="notification-link" href="#immediate-decisions" data-test="notification-center" aria-label="Open immediate decisions queue">
                    <LucideIcon Name="bell" Size="17" />
                    <span>@_decisions.Count</span>
                </a>
            </div>
        </header>

        <ProgramsGuildsSection Programs="@_model.Programs" />

        <ActiveEventWorkspaces Workspaces="@_model.EventWorkspaces" />

        <LeadershipSignalsSection Signals="@_model.LeadershipSignals" />

        <MemberGrowthJourneys Journeys="@_model.GrowthJourneys"
                              OnViewEvidence="OpenEvidenceDrawer" />

        <ChapterRecommendationsSection Recommendations="@_model.ChapterRecommendations" />

        <ChapterHealthSection Items="@_model.ChapterHealth" />

        <DecisionReviewSession IsOpen="@_reviewSessionOpen"
                               Current="@_reviewCurrent"
                               Index="@_reviewIndex"
                               Total="@_decisions.Count"
                               ReturnFocusSelector="@_reviewReturnFocusSelector"
                               OnApprove="ResolveDecisionAsync"
                               OnReject="ResolveDecisionAsync"
                               OnSkip="SkipDecisionAsync"
                               OnClose="CloseReviewSession" />

        <GrowthJourneyEvidenceDrawer IsOpen="@_evidenceDrawerOpen"
                                     Journey="@_selectedJourney"
                                     ReturnFocusSelector="@_evidenceReturnFocusSelector"
                                     OnClosed="HandleEvidenceDrawerClosed" />
    </main>
}

@code {
    private const string ReviewQueueFocusSelector = "[data-test='review-queue-launch'] button";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Task<AuthenticationState>? _processedAuthenticationStateTask;
    private bool _hasProcessedAuthenticationState;
    private CancellationTokenSource? _loadCancellation;
    private int _loadGeneration;
    private CommandCenterAudience? _audience;
    private CommunityCommandCenter? _model;
    private CommunityParticipationHome? _participation;
    private bool _isLoading = true;
    private bool _requiresAuthentication;
    private string? _errorMessage;

    private List<ImmediateDecision> _decisions = [];
    private bool _reviewSessionOpen;
    private int _reviewIndex;
    private ImmediateDecision? _reviewCurrent;
    private string? _reviewReturnFocusSelector;

    private bool _evidenceDrawerOpen;
    private GrowthJourney? _selectedJourney;
    private string? _evidenceReturnFocusSelector;

    protected override async Task OnParametersSetAsync()
    {
        if (_hasProcessedAuthenticationState &&
            ReferenceEquals(AuthenticationStateTask, _processedAuthenticationStateTask))
        {
            return;
        }

        var authenticationStateTask = AuthenticationStateTask;
        _processedAuthenticationStateTask = authenticationStateTask;
        _hasProcessedAuthenticationState = true;
        CancelCurrentLoad();
        _audience = null;
        _model = null;
        _participation = null;
        _decisions = [];
        _reviewSessionOpen = false;
        _reviewCurrent = null;
        _reviewIndex = 0;
        _reviewReturnFocusSelector = null;
        _evidenceDrawerOpen = false;
        _selectedJourney = null;
        _evidenceReturnFocusSelector = null;
        _errorMessage = null;
        _requiresAuthentication = false;
        _isLoading = true;

        var principal = authenticationStateTask is null
            ? new System.Security.Claims.ClaimsPrincipal()
            : (await authenticationStateTask).User;
        if (!ReferenceEquals(authenticationStateTask, AuthenticationStateTask))
        {
            return;
        }

        if (principal.Identity?.IsAuthenticated != true)
        {
            _requiresAuthentication = true;
            _isLoading = false;
            return;
        }

        _requiresAuthentication = false;
        _audience = AudienceResolver.Resolve(principal);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        CancelCurrentLoad();
        var generation = _loadGeneration;
        using var cancellation = new CancellationTokenSource();
        _loadCancellation = cancellation;
        var cancellationToken = cancellation.Token;
        var currentAudience = _audience;

        _isLoading = true;
        _errorMessage = null;

        var role = currentAudience?.Role ?? CommunityRole.CommunityMember;

        try
        {
            if (currentAudience?.Surface == CommandCenterSurface.Participation)
            {
                var loadedParticipation = await ParticipationService.GetAsync(
                    role,
                    currentAudience.DisplayName,
                    cancellationToken);
                if (generation != _loadGeneration)
                {
                    return;
                }

                _model = null;
                _decisions = [];
                _participation = loadedParticipation;
            }
            else
            {
                var loadedModel = await CommandCenterService.GetAsync(role, cancellationToken: cancellationToken);
                if (generation != _loadGeneration)
                {
                    return;
                }

                _participation = null;
                _model = loadedModel;
                _decisions = [.. loadedModel.Decisions];
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (generation == _loadGeneration)
            {
                Logger.LogError(
                    ex,
                    "Unexpected error loading the Homepage projection for surface {Surface} and role {Role}",
                    currentAudience?.Surface,
                    role);
                _errorMessage = "Community signals could not be loaded. Refresh the page to try again.";
            }
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _loadCancellation = null;
                _isLoading = false;
            }
        }
    }

    private void OpenReviewSession()
    {
        if (_decisions.Count == 0)
        {
            return;
        }

        _reviewIndex = 0;
        _reviewCurrent = _decisions[0];
        _reviewReturnFocusSelector = ReviewQueueFocusSelector;
        _reviewSessionOpen = true;
    }

    private void OpenReviewForDecision(ImmediateDecision decision)
    {
        var index = _decisions.FindIndex(item => item.DecisionId == decision.DecisionId);
        if (index < 0)
        {
            return;
        }

        _reviewIndex = index;
        _reviewCurrent = _decisions[index];
        _reviewReturnFocusSelector = $"[data-decision-id='{decision.DecisionId}'] [data-test='decision-review'] button";
        _reviewSessionOpen = true;
    }

    private void CloseReviewSession()
    {
        _reviewSessionOpen = false;
        _reviewCurrent = null;
        _reviewReturnFocusSelector = null;
    }

    private Task ResolveDecisionAsync(ImmediateDecision decision) =>
        RemoveDecisionAsync(decision, advanceReview: true);

    private Task SkipDecisionAsync(ImmediateDecision decision)
    {
        var index = _decisions.FindIndex(item => item.DecisionId == decision.DecisionId);
        if (index < 0 || !_reviewSessionOpen || _decisions.Count == 0)
        {
            return Task.CompletedTask;
        }

        // Skip advances without resolving — the decision stays pending for later HITL review.
        _reviewIndex = (index + 1) % _decisions.Count;
        _reviewCurrent = _decisions[_reviewIndex];
        return Task.CompletedTask;
    }

    private Task RemoveDecisionAsync(ImmediateDecision decision, bool advanceReview)
    {
        var index = _decisions.FindIndex(item => item.DecisionId == decision.DecisionId);
        if (index < 0)
        {
            return Task.CompletedTask;
        }

        // Queue owns the leave animation; Home only mutates the list once.
        _decisions.RemoveAt(index);

        if (!advanceReview || !_reviewSessionOpen)
        {
            return Task.CompletedTask;
        }

        if (_decisions.Count == 0)
        {
            CloseReviewSession();
            return Task.CompletedTask;
        }

        _reviewIndex = Math.Clamp(_reviewIndex, 0, _decisions.Count - 1);
        _reviewCurrent = _decisions[_reviewIndex];
        return Task.CompletedTask;
    }

    private void OpenEvidenceDrawer(GrowthJourney journey)
    {
        _selectedJourney = journey;
        _evidenceReturnFocusSelector = $"[data-evidence-trigger='{journey.MemberId}']";
        _evidenceDrawerOpen = true;
    }

    private void HandleEvidenceDrawerClosed()
    {
        _evidenceDrawerOpen = false;
        _selectedJourney = null;
        _evidenceReturnFocusSelector = null;
    }

    private void CancelCurrentLoad()
    {
        _loadGeneration++;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = null;
    }

    /// <inheritdoc />
    public void Dispose() => CancelCurrentLoad();
}
