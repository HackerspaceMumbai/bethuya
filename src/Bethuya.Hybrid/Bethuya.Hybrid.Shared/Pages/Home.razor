@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Bethuya.Hybrid.Shared.Components.CommandCenter
@using Bethuya.Hybrid.Shared.Components.Participation
@using Bethuya.Hybrid.Shared.Models.CommandCenter
@using Bethuya.Hybrid.Shared.Models.Participation
@using Microsoft.Extensions.Logging
@inject ICommunityCommandCenterService CommandCenterService
@inject ICommunityParticipationService ParticipationService
@inject ICommandCenterAudienceResolver AudienceResolver
@inject ILogger<Home> Logger

<PageTitle>@(audience?.Surface == CommandCenterSurface.Participation ? "My community journey — Bethuya" : "Community Command Center — Bethuya")</PageTitle>

<a class="skip-link" href="#home-main">Skip to main content</a>

@if (requiresAuthentication)
{
    <main id="home-main" class="command-center command-center--loading">
        <div data-test="command-center-auth-required">
            <BbAlert>
                <BbAlertTitle>Sign in to open Bethuya</BbAlertTitle>
                <BbAlertDescription>Your community experience is resolved from your authenticated identity.</BbAlertDescription>
            </BbAlert>
        </div>
    </main>
}
else if (isLoading)
{
    <main id="home-main" class="command-center command-center--loading">
        <div class="command-loading" data-test="loading-state" role="status">Reading community signals…</div>
    </main>
}
else if (errorMessage is not null)
{
    <main id="home-main" class="command-center command-center--loading">
        <div data-test="error-state">
            <BbAlert Variant="AlertVariant.Danger">
                <BbAlertTitle>Home unavailable</BbAlertTitle>
                <BbAlertDescription>@errorMessage</BbAlertDescription>
            </BbAlert>
        </div>
    </main>
}
else if (audience?.Surface == CommandCenterSurface.Participation && participation is not null)
{
    <main id="home-main" class="participation-shell" aria-label="Community participation home">
        <ParticipationSurface Model="@participation"
                              AudienceLabel="@audience.ExperienceLabel"
                              AudienceRole="@audience.Role.ToString()" />
    </main>
}
else if (model is not null && audience is not null)
{
    <main id="home-main"
          class="command-center command-center--v9"
          aria-label="Community operations command center"
          data-test="community-command-center">
        <StrategicInsightPanel Insight="@model.Insight" />

        <ImmediateDecisionsQueue Items="@decisions"
                                 OnPrimary="ResolveDecisionAsync"
                                 OnReview="OpenReviewForDecision"
                                 OnLaunchReviewSession="OpenReviewSession" />

        <header class="command-context" data-test="command-context">
            <div class="command-context__copy">
                <p class="command-kicker">Welcome back, @audience.DisplayName</p>
                <div class="command-audience" data-test="command-center-audience" data-audience="@audience.Role">
                    <span class="command-audience__label">@audience.ExperienceLabel</span>
                    <p class="command-summary">@audience.ExperienceSummary</p>
                </div>
            </div>
            <div class="command-controls" aria-label="Command center controls">
                <a class="notification-link" href="#immediate-decisions" data-test="notification-center" aria-label="Open immediate decisions queue">
                    <LucideIcon Name="bell" Size="17" />
                    <span>@decisions.Count</span>
                </a>
            </div>
        </header>

        <ProgramsGuildsSection Programs="@model.Programs" />

        <ActiveEventWorkspaces Workspaces="@model.EventWorkspaces" />

        <LeadershipSignalsSection Signals="@model.LeadershipSignals" />

        <MemberGrowthJourneys Journeys="@model.GrowthJourneys"
                              OnViewEvidence="OpenEvidenceDrawer" />

        <ChapterRecommendationsSection Recommendations="@model.ChapterRecommendations" />

        <ChapterHealthSection Items="@model.ChapterHealth" />

        <DecisionReviewSession IsOpen="@reviewSessionOpen"
                               Current="@reviewCurrent"
                               Index="@reviewIndex"
                               Total="@decisions.Count"
                               OnApprove="ResolveDecisionAsync"
                               OnReject="ResolveDecisionAsync"
                               OnSkip="SkipDecisionAsync"
                               OnClose="CloseReviewSession" />

        <GrowthJourneyEvidenceDrawer IsOpen="@evidenceDrawerOpen"
                                     Journey="@selectedJourney"
                                     ReturnFocusSelector="@evidenceReturnFocusSelector"
                                     OnClosed="HandleEvidenceDrawerClosed" />
    </main>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Task<AuthenticationState>? processedAuthenticationStateTask;
    private bool hasProcessedAuthenticationState;
    private CancellationTokenSource? loadCancellation;
    private int loadGeneration;
    private CommandCenterAudience? audience;
    private CommunityCommandCenter? model;
    private CommunityParticipationHome? participation;
    private bool isLoading = true;
    private bool requiresAuthentication;
    private string? errorMessage;

    private List<ImmediateDecision> decisions = [];
    private bool reviewSessionOpen;
    private int reviewIndex;
    private ImmediateDecision? reviewCurrent;

    private bool evidenceDrawerOpen;
    private GrowthJourney? selectedJourney;
    private string? evidenceReturnFocusSelector;

    protected override async Task OnParametersSetAsync()
    {
        if (hasProcessedAuthenticationState &&
            ReferenceEquals(AuthenticationStateTask, processedAuthenticationStateTask))
        {
            return;
        }

        var authenticationStateTask = AuthenticationStateTask;
        processedAuthenticationStateTask = authenticationStateTask;
        hasProcessedAuthenticationState = true;
        CancelCurrentLoad();
        audience = null;
        model = null;
        participation = null;
        decisions = [];
        errorMessage = null;
        requiresAuthentication = false;
        isLoading = true;

        var principal = authenticationStateTask is null
            ? new System.Security.Claims.ClaimsPrincipal()
            : (await authenticationStateTask).User;
        if (!ReferenceEquals(authenticationStateTask, AuthenticationStateTask))
        {
            return;
        }

        if (principal.Identity?.IsAuthenticated != true)
        {
            requiresAuthentication = true;
            isLoading = false;
            return;
        }

        requiresAuthentication = false;
        audience = AudienceResolver.Resolve(principal);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        CancelCurrentLoad();
        var generation = loadGeneration;
        using var cancellation = new CancellationTokenSource();
        loadCancellation = cancellation;
        var cancellationToken = cancellation.Token;
        var currentAudience = audience;

        isLoading = true;
        errorMessage = null;

        var role = currentAudience?.Role ?? CommunityRole.CommunityMember;

        try
        {
            if (currentAudience?.Surface == CommandCenterSurface.Participation)
            {
                var loadedParticipation = await ParticipationService.GetAsync(
                    role,
                    currentAudience.DisplayName,
                    cancellationToken);
                if (generation != loadGeneration)
                {
                    return;
                }

                model = null;
                decisions = [];
                participation = loadedParticipation;
            }
            else
            {
                var loadedModel = await CommandCenterService.GetAsync(role, cancellationToken: cancellationToken);
                if (generation != loadGeneration)
                {
                    return;
                }

                participation = null;
                model = loadedModel;
                decisions = [.. loadedModel.Decisions];
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (generation == loadGeneration)
            {
                Logger.LogError(
                    ex,
                    "Unexpected error loading the Homepage projection for surface {Surface} and role {Role}",
                    currentAudience?.Surface,
                    role);
                errorMessage = "Community signals could not be loaded. Refresh the page to try again.";
            }
        }
        finally
        {
            if (generation == loadGeneration)
            {
                loadCancellation = null;
                isLoading = false;
            }
        }
    }

    private void OpenReviewSession()
    {
        if (decisions.Count == 0)
        {
            return;
        }

        reviewIndex = 0;
        reviewCurrent = decisions[0];
        reviewSessionOpen = true;
    }

    private void OpenReviewForDecision(ImmediateDecision decision)
    {
        var index = decisions.FindIndex(item => item.DecisionId == decision.DecisionId);
        if (index < 0)
        {
            return;
        }

        reviewIndex = index;
        reviewCurrent = decisions[index];
        reviewSessionOpen = true;
    }

    private void CloseReviewSession()
    {
        reviewSessionOpen = false;
        reviewCurrent = null;
    }

    private Task ResolveDecisionAsync(ImmediateDecision decision) =>
        RemoveDecisionAsync(decision, advanceReview: true);

    private Task SkipDecisionAsync(ImmediateDecision decision) =>
        RemoveDecisionAsync(decision, advanceReview: true);

    private Task RemoveDecisionAsync(ImmediateDecision decision, bool advanceReview)
    {
        var index = decisions.FindIndex(item => item.DecisionId == decision.DecisionId);
        if (index < 0)
        {
            return Task.CompletedTask;
        }

        // Queue owns the leave animation; Home only mutates the list once.
        decisions.RemoveAt(index);

        if (!advanceReview || !reviewSessionOpen)
        {
            return Task.CompletedTask;
        }

        if (decisions.Count == 0)
        {
            CloseReviewSession();
            return Task.CompletedTask;
        }

        reviewIndex = Math.Clamp(reviewIndex, 0, decisions.Count - 1);
        reviewCurrent = decisions[reviewIndex];
        return Task.CompletedTask;
    }

    private void OpenEvidenceDrawer(GrowthJourney journey)
    {
        selectedJourney = journey;
        evidenceReturnFocusSelector = $"[data-evidence-trigger='{journey.MemberId}']";
        evidenceDrawerOpen = true;
    }

    private void HandleEvidenceDrawerClosed()
    {
        evidenceDrawerOpen = false;
        selectedJourney = null;
        evidenceReturnFocusSelector = null;
    }

    private void CancelCurrentLoad()
    {
        loadGeneration++;
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        loadCancellation = null;
    }

    /// <inheritdoc />
    public void Dispose() => CancelCurrentLoad();
}
