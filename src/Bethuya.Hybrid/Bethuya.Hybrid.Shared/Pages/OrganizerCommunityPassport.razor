@page "/community/passports/{MemberId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = BethuyaAuthorizationPolicies.RequireOrganizer)]
@implements IDisposable
@using Bethuya.Hybrid.Shared.Components.Passport
@using Bethuya.Hybrid.Shared.Services
@inject ICommunityPassportApi CommunityPassportApi
@inject NavigationManager Navigation

<PageTitle>Member Community Passport — Bethuya</PageTitle>

<main data-test="organizer-community-passport">
    <div class="organizer-toolbar">
        <div data-test="passport-directory-back-btn">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo("/community/passports"))">← Passport directory</BbButton>
        </div>
        @if (HasLoadedCurrentPassport)
        {
            <div class="champion-actions">
                @if (HasChampion)
                {
                    <div data-test="passport-revoke-champion-btn"><BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _revokeDialogOpen = true)">Revoke Champion</BbButton></div>
                }
                else
                {
                    <div data-test="passport-award-champion-btn"><BbButton OnClick="@(() => _awardDialogOpen = true)">Award Champion</BbButton></div>
                }
            </div>
        }
    </div>

    @if (_loadError is not null)
    {
        <div class="page-message" data-test="organizer-passport-error"><BbAlert Variant="AlertVariant.Danger">@_loadError</BbAlert></div>
    }
    else if (_loading)
    {
        <div class="page-message" data-test="organizer-passport-loading"><BbAlert Variant="AlertVariant.Info">Opening member passport…</BbAlert></div>
    }
    else if (_passport is { } passport && _loadedMemberId == MemberId)
    {
        @if (_actionError is not null)
        {
            <div class="page-message" data-test="organizer-passport-action-error"><BbAlert Variant="AlertVariant.Danger">@_actionError</BbAlert></div>
        }
        @if (passport.Viewer.IsParticipationRedacted)
        {
            <div class="page-message" data-test="organizer-passport-redacted"><BbAlert Variant="AlertVariant.Warning">This member has not shared participation evidence with organizers. Identity fields remain visible according to their passport settings.</BbAlert></div>
        }
        <PassportExperienceView Model="passport" StatusMessage="@StatusMessage" />
    }
</main>

<BbDialog @bind-Open="_awardDialogOpen">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Award Champion recognition</BbDialogTitle>
            <BbDialogDescription>Champion is organizer-awarded recognition. Give a clear rationale and cite verified evidence where possible.</BbDialogDescription>
        </BbDialogHeader>
        <div class="dialog-form">
            <div class="form-group" data-test="champion-rationale-field">
                <BbLabel>Recognition rationale</BbLabel>
                <BbTextarea @bind-Value="_championRationale" MaxLength="1000" ShowCharacterCount="true" Placeholder="Explain the sustained community impact being recognized." />
            </div>
            @{
                var championEvidence = ChampionEvidence;
            }
            @if (championEvidence.Count > 0)
            {
                <fieldset data-test="champion-evidence-field">
                    <legend>Verified evidence (optional)</legend>
                    @foreach (var contribution in championEvidence)
                    {
                        <label>
                            <input type="checkbox" checked="@_selectedEvidence.Contains(contribution.Id)" @onchange="@(e => ToggleEvidence(contribution.Id, e.Value is true))" />
                            <span>@contribution.Title <small>@contribution.OccurredAt.ToString("dd MMM yyyy")</small></span>
                        </label>
                    }
                </fieldset>
            }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _awardDialogOpen = false)">Cancel</BbButton>
            <div data-test="champion-award-confirm-btn"><BbButton OnClick="AwardChampionAsync" Disabled="@(_saving || string.IsNullOrWhiteSpace(_championRationale))">Award Champion</BbButton></div>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_revokeDialogOpen">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Revoke Champion recognition</BbDialogTitle>
            <BbDialogDescription>The original award remains in the audit history. Record why the active recognition is being revoked.</BbDialogDescription>
        </BbDialogHeader>
        <div class="form-group" data-test="champion-revoke-reason-field">
            <BbLabel>Revocation reason</BbLabel>
            <BbTextarea @bind-Value="_revocationReason" MaxLength="1000" ShowCharacterCount="true" />
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _revokeDialogOpen = false)">Cancel</BbButton>
            <div data-test="champion-revoke-confirm-btn"><BbButton Variant="ButtonVariant.Destructive" OnClick="RevokeChampionAsync" Disabled="@(_saving || string.IsNullOrWhiteSpace(_revocationReason))">Revoke recognition</BbButton></div>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter] public Guid MemberId { get; set; }

    private CommunityPassportExperienceDto? _passport;
    private string? _loadError;
    private string? _actionError;
    private string? StatusMessage { get; set; }
    private string _championRationale = string.Empty;
    private string _revocationReason = string.Empty;
    private readonly HashSet<Guid> _selectedEvidence = [];
    private bool _disposed;
    private bool _loading = true;
    private bool _saving;
    private bool _awardDialogOpen;
    private CancellationTokenSource? _loadCancellationTokenSource;
    private Guid? _loadedMemberId;
    private long _actionGeneration;
    private long _loadGeneration;
    private IReadOnlyList<PassportContributionDto> ChampionEvidence =>
        _passport?.Contributions.Where(item => item.IsLedgerEvidence).Take(8).ToArray() ?? [];
    private bool _revokeDialogOpen;

    private bool HasChampion => _passport?.Signals.Any(signal => signal.Kind == "Champion" && signal.IsOrganizerAwarded) is true;
    private bool HasLoadedCurrentPassport => _passport is not null && _loadedMemberId == MemberId;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_disposed)
        {
            return;
        }

        var requestedMemberId = MemberId;
        var loadGeneration = ++_loadGeneration;
        _actionGeneration++;
        _loadCancellationTokenSource?.Cancel();
        _loadCancellationTokenSource?.Dispose();
        _loadCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _loadCancellationTokenSource.Token;
        _loading = true;
        _saving = false;
        _loadError = null;
        _actionError = null;
        if (_loadedMemberId != requestedMemberId)
        {
            StatusMessage = null;
        }
        _passport = null;
        _loadedMemberId = null;
        _awardDialogOpen = false;
        _revokeDialogOpen = false;
        _championRationale = string.Empty;
        _revocationReason = string.Empty;
        _selectedEvidence.Clear();
        try
        {
            var passport = await CommunityPassportApi.GetMemberExperienceAsync(requestedMemberId, cancellationToken);
            if (_disposed || loadGeneration != _loadGeneration || requestedMemberId != MemberId)
            {
                return;
            }

            _passport = passport;
            _loadedMemberId = requestedMemberId;
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            if (!_disposed && loadGeneration == _loadGeneration && requestedMemberId == MemberId)
            {
                _loadError = "We couldn’t open this member passport. It may be private or unavailable.";
            }
        }
        finally
        {
            if (!_disposed && loadGeneration == _loadGeneration)
            {
                _loading = false;
            }
        }
    }

    private void ToggleEvidence(Guid entryId, bool selected)
    {
        if (selected)
        {
            _selectedEvidence.Add(entryId);
        }
        else
        {
            _selectedEvidence.Remove(entryId);
        }
    }

    private async Task AwardChampionAsync()
    {
        if (_loadedMemberId is not { } memberId || memberId != MemberId)
        {
            return;
        }

        var actionGeneration = ++_actionGeneration;
        _saving = true;
        _actionError = null;
        try
        {
            _ = await CommunityPassportApi.AwardChampionAsync(
                memberId,
                new AwardChampionSignalDto(_championRationale.Trim(), _selectedEvidence.ToArray()));
            if (!IsCurrentAction(memberId, actionGeneration))
            {
                return;
            }

            _awardDialogOpen = false;
            _championRationale = string.Empty;
            _selectedEvidence.Clear();
            await LoadAsync();
            if (_loadedMemberId == memberId && memberId == MemberId)
            {
                StatusMessage = "Champion recognition awarded with an auditable rationale.";
            }
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            if (IsCurrentAction(memberId, actionGeneration))
            {
                _actionError = "We couldn’t award Champion recognition. Check the rationale and evidence, then try again.";
            }
        }
        finally
        {
            if (IsCurrentAction(memberId, actionGeneration))
            {
                _saving = false;
            }
        }
    }

    private async Task RevokeChampionAsync()
    {
        if (_loadedMemberId is not { } memberId || memberId != MemberId)
        {
            return;
        }

        var actionGeneration = ++_actionGeneration;
        _saving = true;
        _actionError = null;
        try
        {
            await CommunityPassportApi.RevokeChampionAsync(memberId, new RevokeChampionSignalDto(_revocationReason.Trim()));
            if (!IsCurrentAction(memberId, actionGeneration))
            {
                return;
            }

            _revokeDialogOpen = false;
            _revocationReason = string.Empty;
            await LoadAsync();
            if (_loadedMemberId == memberId && memberId == MemberId)
            {
                StatusMessage = "Champion recognition revoked. The award history remains auditable.";
            }
        }
        catch (Exception ex) when (ex is Refit.ApiException or HttpRequestException or TaskCanceledException)
        {
            if (IsCurrentAction(memberId, actionGeneration))
            {
                _actionError = "We couldn’t revoke Champion recognition. Check the reason and try again.";
            }
        }
        finally
        {
            if (IsCurrentAction(memberId, actionGeneration))
            {
                _saving = false;
            }
        }
    }

    private bool IsCurrentAction(Guid memberId, long actionGeneration)
        => !_disposed
            && actionGeneration == _actionGeneration
            && _loadedMemberId == memberId
            && MemberId == memberId;

    public void Dispose()
    {
        _disposed = true;
        _loadGeneration++;
        _actionGeneration++;
        _loadCancellationTokenSource?.Cancel();
        _loadCancellationTokenSource?.Dispose();
        _loadCancellationTokenSource = null;
    }
}
