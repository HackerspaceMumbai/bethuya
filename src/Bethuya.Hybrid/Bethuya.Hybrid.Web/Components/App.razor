@using Microsoft.Extensions.DependencyInjection
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <script>
        try {
            var stored = localStorage.getItem("color-scheme");
            document.querySelector('meta[name="color-scheme"]').content = stored ?? "light dark";
            if (stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                document.documentElement.classList.add("dark");
            }
        } catch {}
    </script>
    <base href="/" />
    <link rel="stylesheet" href="_content/Bethuya.Hybrid.Shared/bethuya-theme.css" />
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css" />
    <link rel="stylesheet" href="_content/Bethuya.Hybrid.Shared/app.css" />
    <link rel="stylesheet" href="_content/Bethuya.Hybrid.Shared/opportunity-engine.css" />
    <link rel="stylesheet" href="_content/Bethuya.Hybrid.Shared/community-passport.css" />
    <link rel="stylesheet" href="Bethuya.Hybrid.Web.styles.css" />
    <link rel="icon" type="image/png" href="_content/Bethuya.Hybrid.Shared/favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    @if (_devPersonaToolbarFeature is not null)
    {
        <Bethuya.Hybrid.Web.Components.Dev.DevPersonaToolbar @rendermode="InteractiveServer" />
    }
    <script src="_content/Bethuya.Hybrid.Shared/js/themeToggle.js"></script>
    <script src="_content/Bethuya.Hybrid.Shared/js/cloudinaryUploadGlobal.js"></script>
    <script src="_content/Bethuya.Hybrid.Shared/js/opportunityEngine.js"></script>
    <script src="_content/Bethuya.Hybrid.Shared/js/passportExport.js"></script>
    <script src="_content/Bethuya.Hybrid.Shared/js/evidenceDrawer.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    // Resolved once in OnInitialized (not a computed property) via IServiceProvider (not
    // @inject) so the toolbar's DI marker remains the single source of truth for "dev-only"
    // gating: when IDevPersonaToolbarFeature is not registered (Production, or
    // Authentication:Provider != None), GetService returns null and the component is never
    // constructed — not merely hidden — avoiding a redundant lifecycle (including prerendering)
    // on every request outside Development+Provider=None.
    private Bethuya.Hybrid.Web.Auth.IDevPersonaToolbarFeature? _devPersonaToolbarFeature;

    protected override void OnInitialized()
    {
        _devPersonaToolbarFeature = Services.GetService<Bethuya.Hybrid.Web.Auth.IDevPersonaToolbarFeature>();
    }
}
