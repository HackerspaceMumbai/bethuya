@using Microsoft.Extensions.DependencyInjection
<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Bethuya.Hybrid.Shared/bethuya-theme.css" />
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css" />
    <link rel="stylesheet" href="_content/Bethuya.Hybrid.Shared/app.css" />
    <link rel="stylesheet" href="Bethuya.Hybrid.Web.styles.css" />
    <link rel="icon" type="image/png" href="_content/Bethuya.Hybrid.Shared/favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    @if (DevPersonaToolbarFeature is not null)
    {
        <Bethuya.Hybrid.Web.Components.Dev.DevPersonaToolbar @rendermode="InteractiveServer" />
    }
    <script src="_content/Bethuya.Hybrid.Shared/js/cloudinaryUploadGlobal.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    // Resolved once via IServiceProvider (not @inject) so the toolbar's DI marker remains the
    // single source of truth for "dev-only" gating: when IDevPersonaToolbarFeature is not
    // registered (Production, or Authentication:Provider != None), GetService returns null and
    // the component is never constructed — not merely hidden — avoiding a redundant lifecycle
    // (including prerendering) on every request outside Development+Provider=None.
    private Bethuya.Hybrid.Web.Auth.IDevPersonaToolbarFeature? DevPersonaToolbarFeature =>
        Services.GetService<Bethuya.Hybrid.Web.Auth.IDevPersonaToolbarFeature>();
}