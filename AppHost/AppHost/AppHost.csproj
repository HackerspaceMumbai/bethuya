<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <Nullable>enable</Nullable>
    <UserSecretsId>d4ad228f-7569-48ef-a171-65225c06ec1c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.KeyVault" />
    <PackageReference Include="Aspire.Hosting.Foundry" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Scalar.Aspire" />
    <PackageReference Include="Refit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the small Refit contract without referencing the Razor UI project from AppHost. -->
    <Compile Include="..\..\src\Bethuya.Hybrid\Bethuya.Hybrid.Shared\Services\ICommunityGraphSeedApi.cs" Link="Contracts\ICommunityGraphSeedApi.cs" />
  </ItemGroup>

</Project>
